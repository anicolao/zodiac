{
  "name": "Zodiac — A game becomes a constellation",
  "short_name": "Zodiac",
  "description": "Turn six gameplay photographs into a private, shareable constellation keepsake.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "portrait-primary",
  "background_color": "#031426",
  "theme_color": "#031426",
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "./apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}
